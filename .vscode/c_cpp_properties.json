{
  "configurations": [
    {
      "browse": {
        "databaseFilename": "${default}",
        "limitSymbolsToIncludedHeaders": false
      },
      "includePath": [
        "/workspaces/pixirostemplate/install/example_msgs/include/**",
        "/workspaces/pixirostemplate/install/example_interfaces/include/**",
        "/workspaces/pixirostemplate/.pixi/install/example_msgs/include/**",
        "/workspaces/pixirostemplate/.pixi/install/example_interfaces/include/**",
        "/workspaces/pixirostemplate/.pixi/envs/default/include/**",
        "/usr/include/**"
      ],
      "name": "ROS",
      "intelliSenseMode": "gcc-x64",
      "compilerPath": "/usr/bin/gcc",
      "cStandard": "gnu11",
      "cppStandard": "c++14"
    }
  ],
  "version": 4
}