{
	"name": "pixi_ros_workspace",
	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.pylint",
				"njpwerner.autodocstring",
				"charliermarsh.ruff",
				"mhutchie.git-graph",
				"eamodio.gitlens",
				"tamasfe.even-better-toml",
				"Codium.codium",
				"ms-azuretools.vscode-docker",
				"ryanluker.vscode-coverage-gutters",
				"ms-vscode.cpptools",
				"ms-vscode.cmake-tools",
				"twxs.cmake",
				"ms-iot.vscode-ros",
				"jjjermiah.pixi-vscode"
			]
		}
	},
	"mounts": [
		"source=${localWorkspaceFolderBasename}-pixi,target=${containerWorkspaceFolder}/.pixi,type=volume",
		"source=${localWorkspaceFolderBasename}-ccache,target=/home/vscode/.cache/ccache,type=volume",
		"source=${localEnv:HOME}/.cache/rattler,target=/home/vscode/.cache/rattler,type=bind,consistency=cached"
	],
	"runArgs": [
		"--network=host"
	],
	"containerEnv": {
		"DISPLAY": "${localEnv:DISPLAY}",
		"QT_X11_NO_MITSHM": "1",
		"LIBGL_ALWAYS_SOFTWARE": "1"
	},
	"postCreateCommand": "sudo chown -R vscode /home/vscode/.cache/rattler 2>/dev/null || true && sudo chown -R vscode /home/vscode/.cache/ccache 2>/dev/null || true && sudo chown vscode .pixi && pixi install && mkdir -p src && pixi run import-repos"
}
